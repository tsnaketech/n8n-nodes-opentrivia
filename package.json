{
	"name": "n8n-nodes-opentrivia",
	"version": "0.1.0",
	"description": "n8n community node for the Open Trivia Database (opentdb.com) — fetch trivia questions, categories and session tokens in your n8n workflows.",
	"keywords": [
		"n8n-community-node-package",
		"trivia",
		"opentdb",
		"quiz",
		"opentrivia"
	],
	"license": "MIT",
	"main": "index.js",
	"author": {
		"name": "tsnaketech"
	},
	"homepage": "https://github.com/tsnaketech/n8n-nodes-opentrivia",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tsnaketech/n8n-nodes-opentrivia.git"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"clean": "rimraf dist",
		"build": "tsc && gulp build:icons",
		"rebuild": "npm run clean && npm run build",
		"dev": "tsc --watch",
		"format": "prettier nodes package.json gulpfile.js --write",
		"format:check": "prettier nodes package.json gulpfile.js --check",
		"lint": "eslint nodes package.json ",
		"lint:fix": "eslint nodes package.json --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"ci": "npm run format:check && npm run lint",
		"prepack": "npm run rebuild"
	},
	"files": [
		"dist",
		"README.fr.md",
		"README.es.md",
		"README.de.md"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [],
		"nodes": [
			"dist/nodes/OpenTrivia/OpenTrivia.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.5",
		"gulp": "5.0.1",
		"prettier": "3.9.6",
		"release-it": "21.0.1",
		"rimraf": "6.1.3",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": ">=2"
	}
}
